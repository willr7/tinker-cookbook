[0m[32mshows.sort(key=lambda x: x[1])
[0m[32m
[0m[32mtv_intervals = []  # list of (start, end) for each TV
[0m[32m
[0m[32mtotal_cost = 0
[0m[32m
[0m[32mfor start, end in shows:
[0m[32m    # Try to reuse an existing TV that ends strictly before current start time
[0m[32m    reused = False
[0m[32m    for i, (tv_start, tv_end) in enumerate(tv_intervals):
[0m[32m        if tv_end < start:  # no overlap, can reuse
[0m[32m            # Update the TV's end time to end of current show
[0m[32m            tv_intervals[i] = (tv_start, end)
[0m[32m            reused = True
[0m[32m            break
[0m[32m    
[0m[32m    if not reused:
[0m[32m        # Need a new TV
[0m[32m        tv_intervals.append((start, end))
[0m[32m
[0m[32m# Calculate total cost
[0m[32mfor tv_start, tv_end in tv_intervals:
[0m[32m    cost = x + y * (tv_end - tv_start)
[0m[32m    total_cost = (total_cost + cost) % MOD
[0m[32m
[0m[32mprint(total_cost)
