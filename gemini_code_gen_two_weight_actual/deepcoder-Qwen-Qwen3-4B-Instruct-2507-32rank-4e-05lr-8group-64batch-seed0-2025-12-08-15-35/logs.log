[0m[33m        pairs_in_rest = (count - a) * (count - a - 1) // 2
[0m[33m        total_pairs = pairs_in_a + pairs_in_rest
[0m[33m        min_pairs = min(min_pairs, total_pairs)
[0m[33m    
