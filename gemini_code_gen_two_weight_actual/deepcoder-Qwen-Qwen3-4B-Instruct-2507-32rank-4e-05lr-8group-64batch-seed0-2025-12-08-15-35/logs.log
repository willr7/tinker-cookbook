[0m[33m  - a=1: C(1,2)+C(2,2) = 0+1 = 1  
[0m[33m  - a=2: C(2,2)+C(1,2) = 1+0 = 1
[0m[33m  - a=3: C(3,2)+C(0,2) = 3+0 = 3
[0m[33m  - min = 1
